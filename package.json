{
  "name": "dsh-plugin-prompt",
  "version": "1.6.3",
  "description": "Scene Prompt Flow for DeepSeek Harness: 55 preset subscenes across 10 categories, a legal workflow scene, left-library reorder with drag/move/reset/cancel, a prompt-flow generator meta scene, structured JSON import, and a searchable template library and composer picker.",
  "license": "MIT",
  "author": "qifenglun1",
  "homepage": "https://github.com/qifenglun1/dsh-prompt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qifenglun1/dsh-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/qifenglun1/dsh-prompt/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt-library",
    "prompt-templates",
    "scene-prompts",
    "sidebar"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/scene-system-prompts.test.js"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
